# The payload and the sysroot are binaries: never touch their line endings.
* -text
*.md text
*.sh text eol=lf
*.c text eol=lf
*.h text eol=lf
*.inc text eol=lf
*.cpp text eol=lf
# LF, not the platform's: qemu_ref.txt is diffed against output the emulator
# writes with LF, and the text files are read by a guest.
*.txt text eol=lf
