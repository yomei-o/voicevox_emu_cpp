# Downloads and unpacking scratch: make_sysroot.sh and fetch_models.sh use
# these, but the tree they produce is committed, so a clone needs neither.
dl/
debs/

# Build products.
x86_emu_cpp/x86emu
x86_emu_cpp/x86emu.exe
x86_emu_cpp/gen_elf_tests
x86_emu_cpp/gen_elf_tests.exe
x86_emu_cpp/tests/aes/aesni_elf64
x86_emu_cpp/build/
guest/open_jtalk_dic_utf_8-1.11/
guest/probe
guest/tts
guest/memtest
guest/isatest
sysroot/opt/
*.wav
!web/sample/*.wav
tts_run.log
emu_isatest.txt
api_*.txt
guest/shldtest
guest/vvagent

# Build products of the API layer.
build/
voicevox_core.dll
voicevox_core.lib
voicevox_core.exp
libvoicevox_core_emu.so
apitest.exe
vvsay.exe
sysroot/opt/vv/vvagent
*.log
emu_isatest_new.txt
web_out.wav
web/guest/probe
guest/analyze
build/isatest_*.txt
browser_out.wav
guest/ssebench
guest/cudastub/
guest/cudaguest/
guest/cudaprobe
guest/cudavvm
cuda/
# ...except the runtime the demo page needs, which is carried on purpose: 15 MB
# gzipped, with the provider's GPU code zeroed by tools/slim_provider.sh.
# Without it the page cannot start until someone has fetched a 440 MB release.
!guest/cuda/
!guest/cuda/*.gz
build/api/eigentest*

# The CUDA stand-ins get copied where a Debian with CUDA installed would keep
# them (see run_cudavvm.sh); they are build products either way.
sysroot/lib/x86_64-linux-gnu/libcu*.so.*
sysroot/lib/x86_64-linux-gnu/libcublas*.so.*

# A saved session: 166 MB of decrypted weights, deliberately not carried here.
# tools/wslresume.sh writes one; VVSNAP says where.
*.state
*.state.shim

# Emulator builds kept only to be measured against each other:
# tools/wslbuildpresync.sh makes .presync, tools/wslcudaab.sh reads both.
vvcudaemu.before
vvcudaemu.presync
# A second CMake tree, so a build can happen while the first one is running a
# seventy-minute job and Windows will not let its .exe be replaced.
x86_emu_cpp/build2/
